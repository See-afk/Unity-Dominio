# Unity.gitignore (oficial)

# Carpetas principales generadas automáticamente
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Logs
*.log

# Archivos grandes / temporales
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE (Visual Studio, Rider, etc.)
.vs/
.idea/
.gradle/

# Archivos de proyecto generados
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Archivos generados por Unity en crashes
sysinfo.txt
mono_crash.*

# Builds
*.apk
*.aab
*.app
*.unitypackage

# Otros
.DS_Store
Thumbs.db